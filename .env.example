# Local development. Replace for any public deployment.
POSTGRES_PASSWORD=replace-this-local-only-password
DATABASE_URL=sqlite:///./pipmora.db
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=
# The website forwards /api requests internally. Set API_PROXY_URL only for non-Docker local development.
API_PROXY_URL=http://localhost:8000
APP_ENV=development
COOKIE_SECURE=false
ENABLE_DEV_RESET_LINK=true

# Optional external grounded LLM: disabled by default.
AI_EXTERNAL_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1

# Configure mail delivery before public launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
